# Omni Group web — environment variables (copy to .env.local, never commit secrets)

# Public — Atina API base (browser + server)
NEXT_PUBLIC_ATINA_API_BASE=http://127.0.0.1:3000

# Public — marketing site URL (sitemap, robots)
# NEXT_PUBLIC_SITE_URL=https://omnigroup.example

# Public support inbox shown on homepage, footer, and legal pages.
# Never set this to a personal Gmail/Outlook/Yahoo address.
# NEXT_PUBLIC_SUPPORT_EMAIL=hello@omnigrouptech.com

# Server-only — signed HttpOnly session cookie (required in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Server-only — contact form via Resend (optional; without key returns queued_local_stub)
# D.2 live test: create free key at https://resend.com — use onboarding@resend.dev as FROM for sandbox
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_EMAIL_FROM=onboarding@resend.dev
# CONTACT_EMAIL_TO=your-inbox@example.com
# Optional — push contact leads into Atina CRM (owner/admin credentials, server-only)
# CONTACT_CRM_INGRESS_EMAIL=admin@example.com
# CONTACT_CRM_INGRESS_PASSWORD=your-admin-password
# Optional — Slack ping on new contact (Incoming Webhook URL, server-only)
# CONTACT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Optional — Telegram ping on new contact (server-only; see contact-telegram-notify.ts)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ADMIN_TELEGRAM_NOTIFY=false

# Lovacki modul — admin panel /admin/hunting (BFF rute ispod /api/atina/hunting/*)
# Zahteva pokrenut Atina API + admin login (ne demo sesija)

# Produkcija — kopiraj u .env.production za Docker
# NEXT_PUBLIC_SITE_URL=https://tvoj-domen.com

# P3 monitoring — UptimeRobot: https://tvoj-domen.com/api/health/live
# P3 analytics — set domain only after cookie notice is updated
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=omnigrouptech.com
# P3 ads — leave empty until the ad account is live (no charge until you spend)
# NEXT_PUBLIC_GTM_ID=GTM-XXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXX
# NEXT_PUBLIC_META_PIXEL_ID=1234567890
