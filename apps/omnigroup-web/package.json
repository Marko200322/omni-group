{
  "name": "omnigroup-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "dev:clean": "node scripts/clean-dev-cache.mjs && next dev -p 3010",
    "build": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:atina",
    "test:atina": "node scripts/test-atina-normalize.mjs",
    "smoke:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/smoke-web-integration.ps1",
    "e2e:billing": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/e2e-billing-manual.ps1",
    "e2e:register": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/e2e-register-plan-payment.ps1",
    "test:contact": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/test-contact-resend.ps1",
    "smoke:hunting": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/smoke-hunting-integration.ps1",
    "smoke:hunting:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/smoke-hunting-integration.ps1 -SkipPipeline"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
