# Kopiraj u .env.local (NE commituj)
# Atina API mora biti isti host kao u atina-platform/atina/.env (APP_URL / PORT)

NEXT_PUBLIC_ATINA_API_BASE=http://127.0.0.1:3000
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# Javni URL sajta (staging/prod)
# NEXT_PUBLIC_SITE_URL=https://tvoj-domen.rs

# Kontakt forma (Resend) — obavezno za live kontakt
# RESEND_API_KEY=re_...
# CONTACT_EMAIL_FROM=billing@tvoj-domen.rs
# CONTACT_EMAIL_TO=tvoj-inbox@example.com

# Atina billing email ide preko SMTP u atina-platform/atina/.env (SMTP_* ili COMMS agregator)
