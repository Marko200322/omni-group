NEXT_PUBLIC_ATINA_API_BASE=https://api.tvoj-domen.com
NEXT_PUBLIC_SITE_URL=https://tvoj-domen.com
# lean = M0 minimal API spend (default prod); full = autonomy/scraper/outbound on
NEXT_PUBLIC_PROD_MODE=lean
# Server-side BFF u Dockeru: http://atina-api:3000
ATINA_API_BASE=http://atina-api:3000
# true na HTTPS produkciji; false za lokalni docker-prod test (http://127.0.0.1)
COOKIE_SECURE=true
SESSION_SECRET=change-me-min-32-chars-random-production
RESEND_API_KEY=
CONTACT_EMAIL_FROM=noreply@tvoj-domen.com
CONTACT_EMAIL_TO=admin@tvoj-domen.com
# Fallback lead paths when Resend is down (at least one recommended in prod)
CONTACT_CRM_INGRESS_EMAIL=
CONTACT_CRM_INGRESS_PASSWORD=
CONTACT_SLACK_WEBHOOK_URL=
# Document uploads (requires upload_data volume in docker-compose.prod.yml)
UPLOAD_STORAGE=local
UPLOAD_DIR=/var/omni/uploads
UPLOAD_MAX_BYTES=10485760
