# Nest atina-system — kopiraj u .env ili koristi config/env-aggregator.json (auto pri bootu)
# Za lokalni dev dovoljno je env-aggregator; za prod eksplicitno postavi sve.

NODE_ENV=development
PORT=3001
PHASE=v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=atina
POSTGRES_PASSWORD=atina
POSTGRES_DB=atina
POSTGRES_SSL=false

JWT_SECRET=change-me-min-32-chars-for-development-only
TYPEORM_SYNC=true
TYPEORM_LOG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3010
