{
  "name": "atina-saas",
  "version": "1.0.0",
  "description": "ATINA - Scalable SaaS + AI Automation Platform",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "npx ts-node src/database/migrate.ts",
    "seed": "npx ts-node src/database/seed.ts",
    "test": "jest --runInBand",
    "test:ci": "npm run build && npm run lint && jest --runInBand --coverage --forceExit --testPathIgnorePatterns=integration",
    "test:unit": "jest --runInBand src/tests/unit",
    "test:integration": "jest --runInBand src/tests/integration",
    "test:integration:local": "npm run migrate && npm run test:integration",
    "smoke:health": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/smoke-health.ps1\"",
    "smoke:auth": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/smoke-auth.ps1\"",
    "smoke:forge:status": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/smoke-forge-status.ps1\"",
    "smoke:atina-forge:workflow-template": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/smoke-atina-forge-workflow-template.ps1\"",
    "smoke:forge-admin": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/smoke-forge-admin.ps1\"",
    "smoke:category-rollout": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/smoke-category-rollout.ps1\" -DoSeed",
    "smoke:resume-rollout": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/resume-rollout-when-docker-ready.ps1\" -StartDockerDesktop",
    "check:readiness-100": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/check-readiness-100.ps1\"",
    "sync:generated-verticals": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/export-artifacts-index-from-db.ps1\"",
    "sync:generated-verticals:disk": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/sync-generated-verticals.ps1\"",
    "db:apply-019": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/apply-migration-019.ps1\"",
    "db:apply-020": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/apply-migration-020.ps1\"",
    "smoke:product-factory": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/smoke-product-factory.ps1\"",
    "checklist:apply-env": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/apply-checklist-env.ps1\" -ForceDevOutbound",
    "deploy:production": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/deploy-production.ps1\"",
    "smoke:evolution": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/smoke-evolution.ps1\"",
    "vault:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/vault-db-ops.ps1\" -Action backup",
    "vault:prune": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/vault-db-ops.ps1\" -Action prune",
    "vault:restore:latest": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/vault-db-ops.ps1\" -Action restore-latest",
    "smoke:all": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/smoke-all.ps1\"",
    "smoke:hunting": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/smoke-hunting.ps1\"",
    "smoke:hunting:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/smoke-hunting.ps1\" -SkipPipeline",
    "test:hunt-pipeline": "python test_pipeline.py",
    "dev:check": "npm run smoke:all && npm run lint",
    "free:port": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./scripts/free-port.ps1\"",
    "dev:bootstrap": "npm run db:up && npm run migrate && npm run seed",
    "dev:ready": "npm run dev:bootstrap && npm run lint",
    "dev:start": "npm run db:up && npm run free:port && npm run dev",
    "dev:stop": "npm run free:port && npm run db:down",
    "dev:restart": "npm run dev:stop && npm run dev:start",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose stop postgres redis",
    "docker:migrate": "docker compose run --rm migrate",
    "docker:seed": "docker compose --profile seed run --rm seed",
    "lint": "node --max-old-space-size=8192 ./node_modules/eslint/bin/eslint.js src --ext .ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.19",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "sqlite3": "^6.0.1",
    "stripe": "^14.5.0",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bull": "^3.15.9",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.37",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^2.0.16",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "@types/web-push": "^3.6.3",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
