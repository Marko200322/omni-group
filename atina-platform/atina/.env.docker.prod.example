# Docker produkcija — kopiraj u .env.docker.prod ili pokreni scripts/prepare-docker-prod.ps1
# Ne commituj .env.docker.prod

NODE_ENV=production
PORT=3000
APP_URL=http://127.0.0.1:3002
WEB_APP_URL=http://127.0.0.1:3012
APP_NAME=ATINA

DB_HOST=postgres
DB_PORT=5432
DB_NAME=atina_saas_db
DB_USER=atina_user
DB_PASSWORD=change-me-strong-db-password
DB_SSL=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=change-me-min-32-chars-random-production-jwt
JWT_REFRESH_SECRET=change-me-min-32-chars-random-production-refresh
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

ADMIN_EMAIL=admin@atina.io
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_NAME=System Admin

PAYMENTS_MODE=manual
ALLOW_MANUAL_PAYMENTS_IN_PRODUCTION=true
MANUAL_PAYMENT_ACCOUNT_NAME=
MANUAL_PAYMENT_IBAN=
MANUAL_PAYMENT_BANK=
MANUAL_PAYMENT_CURRENCY=EUR
PAYMENT_NOTIFY_EMAIL=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@omnigroup.io

AUTONOMY_ENABLED=false
AUTONOMY_AUTO_START_SCHEDULER=false
AUTONOMY_EVOLUTION_CODE_EDIT=false

# Agregatori — kopiraj iz lokalnog .env (AI_KEY, COMMS_KEY, SCRAPER_KEY, …)
