# =============================================================================
# ATINA — AGREGATORI (popuni URL + KEY; bez commit-a u Git)
# Ostalo (baza, Redis, JWT, admin…): config/env-aggregator.json
# Provera: repo/scripts/check-atina-aggregators.ps1 + check-stripe-env.ps1
# =============================================================================

# 1. MOZAK — svi AI modeli (npr. OpenRouter)
AI_URL=
AI_KEY=

# 2. BIZNIS, MARKETING I GITHUB (npr. Nango: Meta, Google Ads, HubSpot, GitHub)
BUSINESS_AND_DEV_URL=
BUSINESS_AND_DEV_KEY=

# 3. KRETANJE I PODACI — scraper (npr. Bright Data / slično)
SCRAPER_URL=
SCRAPER_KEY=

# 4. NOVAC — Stripe, PayPal, Wise (FINANCE_KEY = Stripe secret kad koristis Stripe preko agregatora)
FINANCE_URL=
FINANCE_KEY=

# Stripe dodatno (uz FINANCE_*)
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STARTER_PRICE_ID=
PRO_PRICE_ID=
ENTERPRISE_PRICE_ID=

# PayPal / Wise (direktno ili preko FINANCE agregatora)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
WISE_API_KEY=
WISE_PROFILE_ID=

# 5. KOMUNIKACIJA — SMS, WhatsApp, email (npr. Courier)
COMMS_URL=
COMMS_KEY=

# 6. ŠIRENJE / SERVERI — infra kao kod (npr. Pulumi)
INFRASTRUCTURE_URL=
INFRASTRUCTURE_KEY=

# 7. SKLADIŠTE — fajlovi, backup, upload (npr. S3 / R2 / Azure Blob)
STORAGE_URL=
STORAGE_KEY=

# 8–10. Dodatni agregatori (2026-05-20)
CAPTCHA_URL=
CAPTCHA_KEY=
DOMAIN_URL=
DOMAIN_KEY=
WEB3_STORAGE_URL=
WEB3_STORAGE_KEY=

# =============================================================================
# PLATFORM (ne agregatori) — lokalni dev
# =============================================================================

# Faza sistema (boot sync + gating modula)
PHASE=v1

# YouTube pipeline HTTP API (tools/youtube-pipeline, default port 8090)
YOUTUBE_PIPELINE_URL=

# OmniTube voice (opciono)
ELEVENLABS_API_KEY=

# Apex predator soft kill — drzi false osim ako ops eksplicitno odobri
APEX_SUICIDE_SWITCH_ARMED=false
