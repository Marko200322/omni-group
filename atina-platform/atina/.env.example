# =============================================================================
# ATINA — kompletan šablon (popuni URL + KEY; NE commituj .env u Git)
# Provera: .\scripts\check-atina-aggregators.ps1  +  .\scripts\check-stripe-env.ps1
# Vodič: docs/VLASNIK-ENV-POPUNI.md
# =============================================================================

# =============================================================================
# AGREGATORI (10) — prazno = lokalni dev bez live provajdera
# =============================================================================

# 1. AI — Craftor, lead-scoring, OmniTube AI, validator, ai-memory
# OpenRouter: AI_URL=https://openrouter.ai/api/v1  AI_MODEL=openrouter/auto
AI_URL=
AI_KEY=
AI_MODEL=openrouter/auto

# 2. Biznis / marketing / GitHub — integration-hub (Nango)
BUSINESS_AND_DEV_URL=
BUSINESS_AND_DEV_KEY=

# 3. Scraper — client-hunter, proxy-rotation, Craftor hunting
SCRAPER_URL=
SCRAPER_KEY=

# 4. Finance — Stripe secret ide u FINANCE_KEY (STRIPE_SECRET_KEY je alias)
FINANCE_URL=
FINANCE_KEY=
STRIPE_SECRET_KEY=

# Stripe (obavezno za live checkout + webhook)
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STARTER_PRICE_ID=
PRO_PRICE_ID=
ENTERPRISE_PRICE_ID=

# PayPal / Wise (direktno ili preko FINANCE agregatora)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
WISE_API_KEY=
WISE_PROFILE_ID=

# Plaćanje BEZ firme (bankovni transfer + admin potvrda) — dok ne otvoriš firmu / Stripe live
# manual = bez Stripe/PayPal · sandbox = test nalozi · live = produkcija
PAYMENTS_MODE=manual
ALLOW_MANUAL_PAYMENTS_IN_PRODUCTION=false
MANUAL_PAYMENT_ACCOUNT_NAME=
MANUAL_PAYMENT_IBAN=
MANUAL_PAYMENT_BANK=
MANUAL_PAYMENT_SWIFT=
MANUAL_PAYMENT_CURRENCY=EUR
MANUAL_PAYMENT_REFERENCE_PREFIX=ATINA
MANUAL_PAYMENT_NOTE=Uključi referencu u opis uplate. Pretplata se aktivira nakon potvrde admina (do 24h).

# Kriptoman — kripto plaćanja (USDT/BTC checkout)
KRIPTOMAN_ENABLED=false
KRIPTOMAN_URL=
KRIPTOMAN_API_KEY=
KRIPTOMAN_WEBHOOK_SECRET=
KRIPTOMAN_MERCHANT_ID=
KRIPTOMAN_DEFAULT_CRYPTO=USDT
# Lokalni dev bez pravog API-ja (generiše mock checkout URL)
KRIPTOMAN_DEV_MOCK=false
PAYMENT_NOTIFY_EMAIL=

# Video sastanci — prvo support, prodaja kasnije (SALES_MEETINGS_ENABLED=true)
SUPPORT_NOTIFY_EMAIL=
SUPPORT_AGENT_NAME=Mila
SUPPORT_AGENT_TITLE=Tehnička podrška
SUPPORT_AGENT_AVATAR_URL=
SUPPORT_AGENT_VOICE_ID=
SUPPORT_AGENT_GREETING=
SUPPORT_AGENT_PERSONA=
SUPPORT_AVATAR_ENABLED=true
SUPPORT_GOOGLE_MEET_URL=
SALES_MEETINGS_ENABLED=false
SALES_AVATAR_ENABLED=true

# Avatari — AI agregator generiše tim + govor/animacija (preporučeno)
AVATAR_USE_AI_AGGREGATOR=true
# SALES_AGENTS_JSON=[{"id":"nikola","name":"Nikola","title":"Prodaja","avatarUrl":"","voiceId":"","persona":"","greeting":""},{"id":"ana","name":"Ana","title":"Enterprise","avatarUrl":"","voiceId":""}]
SUPPORT_AGENTS_JSON=
SALES_AGENTS_JSON=

# Legacy — prepisuje mila/nikola u default timu ako nema JSON iznad
SALES_AGENT_NAME=Nikola
SALES_AGENT_TITLE=Prodajni konsultant
SALES_AGENT_AVATAR_URL=
SALES_AGENT_VOICE_ID=
SALES_AGENT_GREETING=
SALES_AGENT_PERSONA=
SALES_GOOGLE_MEET_URL=
MEETING_DEFAULT_DURATION_MIN=30
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# 5. Comms — outreach, follow-up, deal-offer, notifications
COMMS_URL=
COMMS_KEY=

# 6. Infrastructure — phase-launch deploy trigger
INFRASTRUCTURE_URL=
INFRASTRUCTURE_KEY=

# 7. Storage — backup, Forge export, upload
STORAGE_URL=
STORAGE_KEY=

# 8. Captcha
CAPTCHA_URL=
CAPTCHA_KEY=

# 9. Domain
DOMAIN_URL=
DOMAIN_KEY=

# 10. Web3 storage
WEB3_STORAGE_URL=
WEB3_STORAGE_KEY=

# =============================================================================
# APLIKACIJA — dev defaulti (promeni za staging/prod)
# =============================================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=ATINA

# =============================================================================
# BAZA I REDIS
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=atina_saas_db
DB_USER=atina_user
DB_PASSWORD=atina_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# AUTH / ADMIN
# =============================================================================

JWT_SECRET=change-me-in-development
JWT_REFRESH_SECRET=refresh-change-me-dev
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

ADMIN_EMAIL=admin@atina.io
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Admin

# =============================================================================
# FAZA I FEATURE FLAGS
# =============================================================================

PHASE=v2
# Autonomy Loop zahteva v2+ u bazi (POST /api/v1/phase-launch/ { "phase": "v3" })
ENABLE_SCRAPER=true
ENABLE_AUTOMATION=true
ENABLE_CRM=true
ENABLE_ANALYTICS=true

# Autonomy Loop (Industry Registry + closed-loop expansion)
AUTONOMY_ENABLED=true
AUTONOMY_AUTO_START_SCHEDULER=true
AUTONOMY_TICK_INTERVAL_MS=300000
AUTONOMY_AUTO_DEPLOY=false
AUTONOMY_GIT_REPO_PATH=
AUTONOMY_GENERATED_DIR=data/generated-verticals
AUTONOMY_MAX_VERTICALS_PER_TICK=3
AUTONOMY_REAL_ECOSYSTEM_RUNS=true

# =============================================================================
# SMTP (COMMS agregator može zameniti slanje)
# =============================================================================

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@atina.io
EMAIL_FROM_NAME=ATINA

# =============================================================================
# FORGE / MONITORING
# =============================================================================

FORGE_VAULT_PATH=data/vault.db
FORGE_MIN_RESERVE_RSD=0
FORGE_HARD_STOP_MODE=false
WORKFLOW_TEMPLATE_SUCCESS_ALERT_THRESHOLD=80

# =============================================================================
# PIPELINE — YouTube / OmniTube / Apex / Craftor / Steam
# =============================================================================

YOUTUBE_PIPELINE_URL=http://127.0.0.1:8090
PIPELINE_HTTP_PORT=8090

ELEVENLABS_API_KEY=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private

CRAFTOR_USE_REAL_SCRAPER=false
CRAFTOR_DEPLOY_PATH=./data/craftor-deploy

STEAM_WEB_API_KEY=

APEX_SUICIDE_SWITCH_ARMED=false
APEX_MAX_SIM_BATCH_PROFILES=1000
APEX_FLUX_API_URL=
APEX_FLUX_API_KEY=
APEX_LIVE_PORTRAIT_API_URL=
APEX_LIVE_PORTRAIT_API_KEY=

# =============================================================================
# RATE LIMITS (opciono — prazno = default iz koda)
# =============================================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=10
AUTH_SESSION_RATE_LIMIT_WINDOW_MS=60000
AUTH_SESSION_RATE_LIMIT_MAX=60

PASSWORD_RESET_WINDOW_MS=3600000
PASSWORD_RESET_MAX=5

PAYMENTS_RATE_LIMIT_WINDOW_MS=600000
PAYMENTS_RATE_LIMIT_MAX=30

WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=120

ADMIN_MUTATION_RATE_LIMIT_WINDOW_MS=900000
ADMIN_MUTATION_RATE_LIMIT_MAX=40

# =============================================================================
# LOGOVANJE
# =============================================================================

LOG_LEVEL=info
LOG_FILE=logs/atina.log
