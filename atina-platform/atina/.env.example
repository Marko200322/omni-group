# =============================================================================
# ATINA — kompletan šablon (popuni URL + KEY; NE commituj .env u Git)
# Provera: .\scripts\check-atina-aggregators.ps1  +  .\scripts\check-stripe-env.ps1
# Vodič: docs/VLASNIK-ENV-POPUNI.md
# =============================================================================

# =============================================================================
# AGREGATORI (10) — prazno = lokalni dev bez live provajdera
# =============================================================================

# 1. AI — Craftor, lead-scoring, OmniTube AI, validator, ai-memory
# OpenRouter: AI_URL=https://openrouter.ai/api/v1  AI_MODEL=openrouter/auto
AI_URL=
AI_KEY=
OPENROUTER_API_KEY=
AI_MODEL=openrouter/auto
# German job-intercept copy (OpenRouter Gemini)
HUNT_GEMINI_MODEL=google/gemini-2.5-flash

# 2. Biznis / marketing / GitHub — integration-hub (Nango)
BUSINESS_AND_DEV_URL=
BUSINESS_AND_DEV_KEY=

# 3. Scraper — client-hunter, proxy-rotation, Craftor hunting
SCRAPER_URL=
SCRAPER_KEY=

# 4. Finance — Stripe secret ide u FINANCE_KEY (STRIPE_SECRET_KEY je alias)
FINANCE_URL=
FINANCE_KEY=
STRIPE_SECRET_KEY=

# Stripe (obavezno za live checkout + webhook)
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STARTER_PRICE_ID=
PRO_PRICE_ID=
ENTERPRISE_PRICE_ID=

# PayPal / Wise (direktno ili preko FINANCE agregatora)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
WISE_API_KEY=
WISE_PROFILE_ID=

# Web app URL (Stripe/PayPal return links) — Next.js domen
WEB_APP_URL=http://localhost:3010

# Web Push (mobilni admin) — generiši: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@omnigroup.io

# Plaćanje BEZ firme (bankovni transfer + admin potvrda) — dok ne otvoriš firmu / Stripe live
# manual = bez Stripe/PayPal · sandbox = test nalozi · live = produkcija
PAYMENTS_MODE=manual
ALLOW_MANUAL_PAYMENTS_IN_PRODUCTION=false
MANUAL_PAYMENT_ACCOUNT_NAME=
MANUAL_PAYMENT_IBAN=
MANUAL_PAYMENT_BANK=
MANUAL_PAYMENT_SWIFT=
MANUAL_PAYMENT_CURRENCY=EUR
MANUAL_PAYMENT_REFERENCE_PREFIX=ATINA
MANUAL_PAYMENT_NOTE=Uključi referencu u opis uplate. Pretplata se aktivira nakon potvrde admina (do 24h).

# Kriptoman — kripto plaćanja (USDT/BTC checkout)
KRIPTOMAN_ENABLED=false
KRIPTOMAN_URL=
KRIPTOMAN_API_KEY=
KRIPTOMAN_WEBHOOK_SECRET=
KRIPTOMAN_MERCHANT_ID=
KRIPTOMAN_DEFAULT_CRYPTO=USDT
# Lokalni dev bez pravog API-ja (generiše mock checkout URL)
KRIPTOMAN_DEV_MOCK=false
PAYMENT_NOTIFY_EMAIL=

# Produkcija — autonomy + agregatori (AI, scraper, COMMS)
AUTONOMY_ENABLED=true
AUTONOMY_AUTO_START_SCHEDULER=true
AUTONOMY_ROLLOUT_SEGMENT=freelance
AUTONOMY_EVOLUTION_CODE_EDIT=false
AI_URL=https://openrouter.ai/api/v1
AI_KEY=
SCRAPER_URL=
SCRAPER_KEY=
COMMS_URL=
COMMS_KEY=

# Video sastanci — prvo support, prodaja kasnije (SALES_MEETINGS_ENABLED=true)
SUPPORT_NOTIFY_EMAIL=
SUPPORT_AGENT_NAME=Mila
SUPPORT_AGENT_TITLE=Tehnička podrška
SUPPORT_AGENT_AVATAR_URL=
SUPPORT_AGENT_VOICE_ID=
SUPPORT_AGENT_GREETING=
SUPPORT_AGENT_PERSONA=
SUPPORT_AVATAR_ENABLED=true
SUPPORT_GOOGLE_MEET_URL=
SALES_MEETINGS_ENABLED=false
SALES_AVATAR_ENABLED=true

# Premium video avatari — redosled provajdera (prvi konfigurisan pobeđuje)
# heygen,d-id,live_portrait
AVATAR_VIDEO_PROVIDER_CHAIN=heygen,d-id,live_portrait
HEYGEN_API_KEY=
DID_API_KEY=
# Glas — elevenlabs,cartesia
AVATAR_TTS_PROVIDER_CHAIN=elevenlabs,cartesia
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-2

# Cursor Agent (platform evolution) — https://cursor.com/settings → API Keys
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_RUNTIME=local
CURSOR_REPO_PATH=
CURSOR_CLOUD_REPO_URL=
CURSOR_EVOLUTION_ENABLED=false
CURSOR_AGENT_ENABLED=false

# Avatar pamti klijente kroz ai-memory + agregator (Pinecone/Qdrant na gateway-u)
AVATAR_CLIENT_MEMORY_ENABLED=true
AVATAR_PUBLIC_BASE_URL=http://localhost:3010
WEB_APP_URL=http://localhost:3010
ELEVENLABS_DEFAULT_VOICE_ID=pNInz6obpgDQGcFmaJgB
# Portreti i WFH pozadine serviraju se sa web app-a (:3010/avatars/...)
SUPPORT_AGENT_AVATAR_URL=/avatars/portraits/mila.svg
SALES_AGENT_AVATAR_URL=/avatars/portraits/nikola.svg
# Opciono: ceo tim iz env-a (inače DB + default roster u kodu)
# SUPPORT_AGENTS_JSON=[{"id":"mila","name":"Mila","title":"Tehnička podrška","avatarUrl":"/avatars/portraits/mila.svg","backgroundUrl":"/avatars/backgrounds/support-wfh.svg","voiceId":"21m00Tcm4TlvDq8ikWAM","persona":"","greeting":""}]
SUPPORT_AGENTS_JSON=
SALES_AGENTS_JSON=

# Legacy — prepisuje mila/nikola u default timu ako nema JSON iznad
SALES_AGENT_NAME=Nikola
SALES_AGENT_TITLE=Prodajni konsultant
SALES_AGENT_AVATAR_URL=
SALES_AGENT_VOICE_ID=
SALES_AGENT_GREETING=
SALES_AGENT_PERSONA=
SUPPORT_GOOGLE_MEET_URL=
SALES_GOOGLE_MEET_URL=
MEETING_DEFAULT_DURATION_MIN=30
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# 5. Comms — outreach, follow-up, deal-offer, notifications
COMMS_URL=
COMMS_KEY=
RESEND_API_KEY=

# 6. Infrastructure — phase-launch deploy trigger
INFRASTRUCTURE_URL=
INFRASTRUCTURE_KEY=

# 7. Storage — backup, Forge export, upload
STORAGE_URL=
STORAGE_KEY=

# 8. Captcha
CAPTCHA_URL=
CAPTCHA_KEY=

# 9. Domain
DOMAIN_URL=
DOMAIN_KEY=

# 10. Web3 storage
WEB3_STORAGE_URL=
WEB3_STORAGE_KEY=

# =============================================================================
# APLIKACIJA — dev defaulti (promeni za staging/prod)
# =============================================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=ATINA

# =============================================================================
# BAZA I REDIS
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=atina_saas_db
DB_USER=atina_user
DB_PASSWORD=atina_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# AUTH / ADMIN
# =============================================================================

JWT_SECRET=change-me-in-development
JWT_REFRESH_SECRET=refresh-change-me-dev
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

ADMIN_EMAIL=admin@atina.io
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Admin

# Public self-serve register (production is closed unless true)
REGISTRATION_ENABLED=true

# Founding overlay — must match NEXT_PUBLIC_* on web when enabled
FOUNDING_CLIENT_PROMO=false
FOUNDING_CLIENT_DISCOUNT_PCT=15

# =============================================================================
# FAZA I FEATURE FLAGS
# =============================================================================

PHASE=v2
# Autonomy Loop zahteva v2+ u bazi (POST /api/v1/phase-launch/ { "phase": "v3" })
ENABLE_SCRAPER=true
ENABLE_AUTOMATION=true
ENABLE_CRM=true
ENABLE_ANALYTICS=true

# Autonomy Loop (Industry Registry + closed-loop expansion)
AUTONOMY_ENABLED=true
AUTONOMY_AUTO_START_SCHEDULER=true
AUTONOMY_TICK_INTERVAL_MS=300000
AUTONOMY_AUTO_DEPLOY=false
AUTONOMY_GIT_REPO_PATH=
AUTONOMY_GENERATED_DIR=data/generated-verticals
AUTONOMY_MAX_VERTICALS_PER_TICK=3
AUTONOMY_REAL_ECOSYSTEM_RUNS=true
AUTONOMY_CATEGORY_ROLLOUT_ENABLED=true
AUTONOMY_CATEGORY_ROLLOUT_MAX_CATEGORIES=1
AUTONOMY_CATEGORY_ROLLOUT_BATCH_SIZE=8
# freelance = samo online poslovi (25); legacy_smb = SMB dodatak; all = 50
AUTONOMY_ROLLOUT_SEGMENT=freelance
AUTONOMY_EVOLUTION_RUN_TESTS=true
# E3 evolution agent — bezbedne auto-izmjene u monorepo-u (dev only, ne produkcija)
AUTONOMY_EVOLUTION_CODE_EDIT=true
# Apsolutna putanja do generated-verticals-index.json (host); u Dockeru prazno = samo count
AUTONOMY_WEB_GENERATED_INDEX_PATH=

# Product Factory — custom softver po narudžbini + interni SaaS (izolovano)
PRODUCT_FACTORY_ENABLED=true
PRODUCT_FACTORY_OUTPUT_DIR=data/product-factory
PRODUCT_FACTORY_RUN_TESTS=true
PRODUCT_FACTORY_INTERNAL_LANE=true
PRODUCT_FACTORY_MAX_INTERNAL_PER_TICK=1
INFRASTRUCTURE_LOCAL_FALLBACK=true

# Umeren budžet (USD) — sistem ne troši ispod rezerve / preko dnevnog limita
AUTONOMY_INITIAL_BUDGET_USD=50
AUTONOMY_MAX_SPEND_PER_TICK_USD=2
AUTONOMY_MAX_SPEND_PER_DAY_USD=10
AUTONOMY_MIN_RESERVE_USD=15
AUTONOMY_REVENUE_REINVEST_RATE=0.2
AUTONOMY_MARKETING_ENABLED=false
AUTONOMY_MARKETING_MIN_PRIORITY=40
AUTONOMY_COST_RESEARCH_USD=0.2
AUTONOMY_COST_GENERATE_USD=0.05
AUTONOMY_COST_DEPLOY_USD=0.1
AUTONOMY_COST_AI_LEARN_USD=0.08
AUTONOMY_COST_MARKETING_USD=0.5

# Slack ops (shop, support, fulfillment notifications)
SLACK_WEBHOOK_URL=

# Deliverable fulfillment QA / retry
DELIVERABLE_FULFILLMENT_QA_ENABLED=false
DELIVERABLE_FULFILLMENT_MAX_RETRIES=3
DELIVERABLE_FULFILLMENT_MEMORY_ENABLED=true

# Retainer scheduler (lead-gen, ai-support MRR)
RETAINER_SCHEDULER_ENABLED=true
RETAINER_SCHEDULER_TICK_CRON=0 9 1 * *

# Revenue allocation / tax reserve (admin)
OWNER_TAX_RESERVE_RATE=0.15
REVENUE_ALLOCATION_ENABLED=true

# Telegram izveštaji (COMMS agregator ili direktno Bot API)
ADMIN_TELEGRAM_NOTIFY=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTONOMY_TELEGRAM_NOTIFY=true

# =============================================================================
# LOVACKI MODUL (client-hunter stack)
# =============================================================================
# ENABLE_SCRAPER + AUTONOMY_REAL_ECOSYSTEM_RUNS = pravi workflow runovi (ne simulacija)
ENABLE_SCRAPER=true
ENABLE_CRM=true
ENABLE_ANALYTICS=true
AUTONOMY_REAL_ECOSYSTEM_RUNS=true
# Dev: true = šalji outbound na OUTREACH_FALLBACK_EMAIL bez domain warmup
OUTREACH_DEV_SEND_TO_FALLBACK=true
OUTREACH_FALLBACK_EMAIL=

# Outbound email queue — draft odmah, send tek kad je domen zagrejan
OUTREACH_WARMUP_MODE=true
OUTREACH_DOMAIN_WARMUP_COMPLETE=false
OUTREACH_DAILY_CAP=20
# Instantly.ai — leave provider=resend until Instantly campaign is ready (do not enable for first sale)
OUTREACH_EMAIL_PROVIDER=resend
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
# Commercial hunt: skip government job boards; only company emails in CRM/outbound
HUNT_EXCLUDE_PLATFORM_KINDS=government
HUNT_COMPANY_EMAILS_ONLY=true
OUTREACH_FALLBACK_EMAIL=
# Dev: šalji draftove na fallback bez warmup (ne u produkciji)
OUTREACH_DEV_SEND_TO_FALLBACK=false

# =============================================================================
# LEAD BAZE + EMAIL VERIFY (fazno paljenje F0–F5) — docs/LEAD-DATABASES-PHASED.md
# =============================================================================
# F0–F1: samo Apify web scrape (default)
# F3+:  enrich na hunt kad uključiš LEAD_DATABASE_ENABLED=true
LEAD_DATABASE_ENABLED=false
LEAD_DATABASE_ROLLOUT_PHASE=F0
# Forsiraj enrich pre faze (opciono): LEAD_ENRICH_ON_HUNT=true
LEAD_ENRICH_ON_HUNT=false
LEAD_ENRICH_MAX_PER_RUN=10
LEAD_DATABASE_PROVIDER_CHAIN=apollo,hunter,lusha,snov,zoominfo
EMAIL_VERIFICATION_PROVIDER_CHAIN=neverbounce,zerobounce

# Apollo.io → https://app.apollo.io → Settings → API
APOLLO_API_KEY=
# Hunter.io → https://hunter.io/api-keys
HUNTER_API_KEY=
# Lusha → https://dashboard.lusha.com/enrichment/api
LUSHA_API_KEY=
# Snov.io → API credentials (client_id + secret)
SNOV_USER_ID=
SNOV_API_KEY=
# ZoomInfo (enterprise — opciono)
ZOOMINFO_API_KEY=
ZOOMINFO_API_URL=

# Email verification (F2+)
NEVERBOUNCE_API_KEY=
ZEROBOUNCE_API_KEY=

# =============================================================================
# External AI stack (M4/M5) — ključevi + svrha + povezivanje
# Status: GET /api/v1/billing/factory-phase/status → externalAiStack
# Budžet ops ~€500–1200 / izvršni ~€200–800 — popuni samo što koristiš
