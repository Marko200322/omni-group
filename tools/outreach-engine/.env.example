# === Stub / local (no live keys required) ===
# Set true while developing guardrails or n8n graph without Tavily/OpenAI.
OUTREACH_STUB_MODE=true
OUTREACH_ENABLED=false
OUTREACH_MODE=draft
# draft | email | webhook

TAVILY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=

# Omni source of truth (public BFF + Atina API)
MY_WEBSITE_API_URL=https://omnigrouptech.com
ATINA_API_URL=https://api.omnigrouptech.com
# Local Atina example:
# ATINA_API_URL=http://127.0.0.1:3000
CONTEXT_DELIVERABLES_PATH=/api/v1/billing/deliverables
CONTEXT_INDUSTRY_CATALOG_PATH=/api/atina/billing/industry-catalog
CONTEXT_CATEGORY_PRICING_PATH=/api/atina/billing/category-pricing

# Checkout — ONLY platform URLs (never invent payment links)
CHECKOUT_BASE_URL=https://omnigrouptech.com/pricing
PUBLIC_SITE_URL=https://omnigrouptech.com

# Dispatch (unused while OUTREACH_ENABLED=false)
DISPATCH_FROM_EMAIL=outreach@omnigrouptech.com
DISPATCH_REVIEW_INBOX=
DISPATCH_WEBHOOK_URL=

# Models (used only when OpenAI credentials exist in n8n)
AGENT1_MODEL=gpt-4o-mini
AGENT2_MODEL=gpt-4o

# Stealth / proxy (optional)
HTTP_PROXY=
HTTPS_PROXY=
SOCKS_PROXY=
PROXY_ENABLED=false

# Timing (seconds)
CRON_INTERVAL_MINUTES=20
DELAY_MIN_SECONDS=240
DELAY_MAX_SECONDS=1080

# Logging
AUDIT_DB_PATH=./data/outreach-audit.sqlite
LOG_LEVEL=info

# n8n host
N8N_ENCRYPTION_KEY=
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
WEBHOOK_URL=http://localhost:5678/

# === Live keys (fill when leaving stub mode) ===
# OUTREACH_STUB_MODE=false
# TAVILY_API_KEY=tvly-...
# OPENAI_API_KEY=sk-...
# RESEND_API_KEY=re_...
# DISPATCH_REVIEW_INBOX=you@example.com
